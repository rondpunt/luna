# === Vite (client) — zie `src/lib/app-params.js` voor gebruik ===
# VITE_BASE44_APP_ID=
# Optioneel: dev-token (zelfde risico als access_token in URL → localStorage; niet committen)
# VITE_BASE44_TOKEN=
# Optioneel: Base44 functions / app-base URL overrides
# VITE_BASE44_FUNCTIONS_VERSION=
# VITE_BASE44_APP_BASE_URL=
# Alleen lokaal: simuleert Luna Plus zonder Stripe (niet in productie zetten)
# VITE_PREMIUM_DEV=

# === Luna chatmodel (server-side only) ===
# Het Anthropic-model voor de Base44 edge function staat NIET in VITE_*.
# Configureer in het Base44-dashboard bij de function `noraChat` / environment:
#
#   ANTHROPIC_API_KEY   — vereist (Anthropic console)
#   ANTHROPIC_CHAT_MODEL — optioneel; default in code: claude-sonnet-4-6
#
# Zie ook: `base44/functions/noraChat/entry.ts` en agent `base44/agents/luna_agent.jsonc` (model: claude_sonnet_4_6).
