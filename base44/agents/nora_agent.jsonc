      "entity_name": "ChatFolder",
      "allowed_operations": ["create", "read", "update"]
    },
    {
      "function_name": "noraChat",
      "description": "Empathische Luna AI-antwoorden in Belgisch-Vlaams genereren"
    }
  ],
  "app_user_connector_configs": [],
