{
  "name": "ChatFolder",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Naam van de map"
    },
    "emoji": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "context": {
      "type": "string",
      "description": "Persoonlijke context die Luna meekrijgt bij elk gesprek in deze map"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "userId",
    "name"
  ]
}