{
  "name": "VaultTopic",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "person",
        "situation",
        "theme",
        "trigger",
        "goal"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "emotions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "last_mentioned_at": {
      "type": "string",
      "format": "date-time"
    },
    "mention_count": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "category",
    "title"
  ]
}