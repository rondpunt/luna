{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "folderId": {
      "type": "string",
      "description": "Optionele map-ID"
    },
    "folderName": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Korte AI-samenvatting van het gesprek"
    },
    "mood": {
      "type": "string",
      "description": "Stemming aan begin van gesprek"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "agentConversationId": {
      "type": "string",
      "description": "ID van de agent conversation voor continu\u00efteit"
    }
  },
  "required": [
    "userId",
    "title"
  ]
}