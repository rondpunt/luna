{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation this message belongs to"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Who sent this message"
    },
    "content": {
      "type": "string",
      "description": "The message text"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "none",
        "elevated",
        "acute"
      ],
      "default": "none",
      "description": "Crisis risk level detected"
    }
  },
  "required": [
    "conversation_id",
    "role",
    "content"
  ]
}