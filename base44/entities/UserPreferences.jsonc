{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_moods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hoe gebruiker zich meestal voelt (onboarding hook)"
    },
    "preferred_moments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Wanneer gebruiker Luna wil gebruiken (onboarding hook)"
    },
    "notificationTime": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "auto"
      ],
      "default": "auto"
    },
    "voiceEnabled": {
      "type": "boolean",
      "default": true
    },
    "aiResponseStyle": {
      "type": "string",
      "enum": [
        "shorter",
        "deeper",
        "practical"
      ],
      "default": "shorter"
    },
    "preferredLanguage": {
      "type": "string",
      "default": "nl"
    },
    "crisisDisclaimerAccepted": {
      "type": "boolean",
      "default": false
    },
    "chatSettings": {
      "type": "object",
      "description": "Chat overzicht voorkeuren",
      "properties": {
        "showSearch": {
          "type": "boolean",
          "default": false
        },
        "showPin": {
          "type": "boolean",
          "default": false
        },
        "showArchive": {
          "type": "boolean",
          "default": false
        },
        "showQuickMove": {
          "type": "boolean",
          "default": false
        },
        "showCounts": {
          "type": "boolean",
          "default": false
        },
        "compactList": {
          "type": "boolean",
          "default": false
        },
        "showDateGroups": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": [
    "userId"
  ]
}