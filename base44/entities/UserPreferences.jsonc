{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "concern": {
      "type": "string",
      "enum": ["bpd", "adhd", "both", "autism", "combination", "unsure", "other"],
      "description": "Primary concern uit onboarding (bpd/adhd/autism/combination/unsure; both = legacy)"
    },
    "onboardingCompleted": {
      "type": "boolean",
      "default": false,
      "description": "Vlag voor onboarding loop-fix"
    },
    "goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primary_moods": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Hoe gebruiker zich meestal voelt (onboarding stap 2)"
    },
    "preferred_moments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Wanneer gebruiker Luna wil gebruiken (onboarding stap 3)"
    },
    "notificationTime": { "type": "string" },
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "auto"],
      "default": "dark"
    },
    "aiResponseStyle": {
      "type": "string",
      "enum": ["shorter", "structured", "deeper", "practical"],
      "default": "shorter",
      "description": "Gestuurd door onboarding (communicatie); structured = meer houvast"
    },
    "onboarding_profile": {
      "type": "string",
      "description": "JSON string v1: reduceAnimations, calmPalette, fewerCelebrations, plainMode, communicationDirectness, replyShape — zie src/lib/lunaComfortPreferences.js"
    },
    "preferredLanguage": {
      "type": "string",
      "default": "nl"
    },
    "crisisDisclaimerAccepted": {
      "type": "boolean",
      "default": false
    },
    "chatSettings": {
      "type": "object",
      "description": "Chat-overzicht UI (lijst, pins, …) — zie useChatSettings.js"
    },
    "calmUi": {
      "type": "boolean",
      "description": "Spiegel van onboarding_profile.calmPalette (legacy / snelle reads)"
    },
    "reduceMotionUi": {
      "type": "boolean",
      "description": "Spiegel van onboarding_profile.reduceAnimations (legacy / snelle reads)"
    }
  },
  "required": ["userId"]
}
