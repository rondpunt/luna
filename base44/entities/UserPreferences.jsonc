{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "concern": {
      "type": "string",
      "enum": ["bpd", "adhd", "both", "unsure", "other"],
      "description": "Primary concern uit onboarding stap 4"
    },
    "onboardingCompleted": {
      "type": "boolean",
      "default": false,
      "description": "Vlag voor onboarding loop-fix"
    },
    "goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primary_moods": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Hoe gebruiker zich meestal voelt (onboarding stap 2)"
    },
    "preferred_moments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Wanneer gebruiker Luna wil gebruiken (onboarding stap 3)"
    },
    "notificationTime": { "type": "string" },
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "auto"],
      "default": "dark"
    },
    "aiResponseStyle": {
      "type": "string",
      "enum": ["shorter", "deeper", "practical"],
      "default": "shorter"
    },
    "preferredLanguage": {
      "type": "string",
      "default": "nl"
    },
    "crisisDisclaimerAccepted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["userId"]
}
