{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "system"
      ],
      "default": "text"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "none",
        "elevated",
        "acute"
      ],
      "default": "none"
    }
  },
  "required": [
    "conversation_id",
    "role",
    "content"
  ]
}