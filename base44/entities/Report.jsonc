{
  "name": "Report",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "session",
        "therapist",
        "therapist_export"
      ],
      "default": "weekly"
    },
    "title": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "content": {
      "type": "string"
    },
    "preview": {
      "type": "string"
    },
    "insights": {
      "type": "object"
    },
    "pdf_data": {
      "type": "object"
    },
    "pdf_url": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "title"
  ]
}