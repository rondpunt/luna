{
  "name": "Tag",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "cluster": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "toLabel": {
            "type": "string"
          },
          "strength": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "label",
    "cluster"
  ]
}